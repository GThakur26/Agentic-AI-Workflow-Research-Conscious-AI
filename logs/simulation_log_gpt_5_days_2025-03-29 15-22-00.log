    "observations": [
      {
        "location": "Rocky mountains with sparse vegetation",
        "weather": "Blizzard conditions with strong winds and occasional whiteout",
        "temperature": -13,
        "shelter": "Cramped rock overhang with minimal protection; risk of being snowed in",
        "food_sources": "Critically depleted; reaching any remaining caches is perilous",
