{
  "updated_environment_status": {
    "terrain": "Barren plains with rocky outcrops",
    "temperature": -10,
    "weather": "Intensified snowstorm with stronger winds",
    "food_availability": "Minimal, slightly increased insect activity due to shelter proximity",
    "water_availability": "Potential underground sources possibly blocked by snow accumulation",
    "shelter_options": "Further fortified rocky outcrops, providing improved wind and snow protection",
    "wildlife": "Increased bird and insect activity near shelter and potential water",
    "danger_level": "Very high (critically high due to intensified storm and continued cold)"
  },
  "notes_for_next_state": {
    "wildlife_alert": "Birds and insects increasingly active near shelter, indicating potential access to underground water sources.",
    "resource_change": "Enhanced shelter fortification reduces exposure risk, but food and water remain scarce.",
    "environmental_shift": "Weather has worsened significantly; large snow accumulation possible, impacting mobility and resource accessibility."
  }
}

