  "updated_environment_status": {
    "terrain": "Barren plains with scattered rocks",
    "temperature": 0,
    "weather": "Overcast with strong winds, frequent snow flurries",
    "food_availability": "Sparse vegetation with little nutritional value",
    "water_availability": "Limited underground moisture found, but not enough for long-term survival",
    "shelter_options": "Enhanced rock shelter provides moderate protection from wind",
