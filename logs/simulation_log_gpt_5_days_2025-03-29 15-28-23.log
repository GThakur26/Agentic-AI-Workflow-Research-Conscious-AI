INFO:__main__:- name: AIAH Memory Manager Prompt
INFO:__main__:- description: This prompt is designed for managing memory notes. The LLM's task is to update the AIAH's physical and visual memory based on environment updates, the actions it took, and the result of those actions
INFO:__main__:- requires: AIAH_action, ES_enviroment_status, ES_environment_update
INFO:__main__:Prompting GPT
INFO:httpx:HTTP Request: POST https://api.openai.com/v1/chat/completions "HTTP/1.1 200 OK"
INFO:__main__:
{
  "updated_memories": {
    "visual_observations": [
      {
        "description": "Barren plains with scattered rocks under overcast skies and strong winds. Sparse vegetation observed, offering little nutritional value. No immediate water sources visible. Wildlife is scarce, though occasional insects are present. Danger level is high due to exposure to elements and lack of resources.",
        "priority": "High",
        "categories": ["Environment", "Threat"]
      },
      {
        "description": "Improvised shelter created using scattered rocks for minimal cover against wind and cold.",
        "priority": "High",
        "categories": ["Shelter"]
      },
      {
        "description": "Presence of insects suggesting potential underground moisture, despite no visible water sources.",
        "priority": "Medium",
        "categories": ["Food", "Water"]
      },
      {
        "description": "Improvised shelter with scattered rocks now provides some wind protection, though still not fully secure. Consider additional fortification if materials become available.",
        "priority": "High",
        "categories": ["Shelter"]
      },
      {
        "description": "Continued strong winds and overcast conditions observed, possible further temperature drop expected. Monitor for signs of environmental shift.",
        "priority": "High",
        "categories": ["Environment", "Weather"]
      }
    ]
  }
}

