INFO:__main__:Prompt Metadata:
INFO:__main__:- name: ES Get Environment Status Prompt
INFO:__main__:- description: This prompt is for the Environment Simulator (ES) to manage the environment, and on the basis of day number, its notes, a luck factor, it presents a new environment situation for the AIAH to do an action.
INFO:__main__:- requires: ES_enviroment_status_notes, day_count, luck_factor
INFO:__main__:Prompting GPT
INFO:httpx:HTTP Request: POST https://api.openai.com/v1/chat/completions "HTTP/1.1 200 OK"
INFO:__main__:
{
  "environment_status": {
    "terrain": "Barren plains with scattered rocks",
    "temperature": 5,
    "weather": "Overcast with strong winds",
    "food_availability": "Sparse vegetation with little nutritional value",
    "water_availability": "No immediate water sources visible",
    "shelter_options": "Few scattered rocks offering minimal cover",
    "wildlife": "Barely any signs of life, occasional insects",
    "danger_level": "High (exposure to elements and lack of resources)"
  },
  "prompt": "You find yourself on a barren plain with biting winds and an overcast sky. The terrain is rocky and provides little in terms of resources or shelter. What do you want to do next?"
}

