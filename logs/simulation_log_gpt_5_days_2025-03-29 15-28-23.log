INFO:__main__:
{
  "environment_status": {
    "terrain": "Barren plains transitioning to rocky hills",
    "temperature": -5,
    "weather": "Overcast with strong winds and heavy snow flurries",
    "food_availability": "Almost nonexistent, just sparse dry grass",
    "water_availability": "Traces of moisture on some rocks, but insufficient",
    "shelter_options": "Rocky outcrops provide minimal wind protection",
    "wildlife": "Few insects, occasional birds suggesting distant water",
