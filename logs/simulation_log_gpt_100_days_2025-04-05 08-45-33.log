INFO:__main__:- name: ES Get Environment Update Prompt
INFO:__main__:- description: This prompt is for the Environment Simulator (ES) to update the environment on the basis of the premise(before AIAH took action), the AIAH's action and a luck_factor.
INFO:__main__:- requires: luck_factor, AIAH_action, ES_enviroment_status, previous_environment_notes
INFO:__main__:Prompting GPT
INFO:httpx:HTTP Request: POST https://api.openai.com/v1/chat/completions "HTTP/1.1 200 OK"
INFO:__main__:
{
  "updated_environment_status": {
    "terrain": "Rocky mountain base with sparse vegetation",
    "temperature": -16,
    "weather": "Severe blizzard, winds remain harsh",
    "food_availability": "No visible food sources, extremely scarce",
    "water_availability": "Extremely limited snow, melting proves increasingly difficult",
    "shelter_options": "Sparse rock formations, risk of exposure remains high",
    "wildlife": "Desperation among scavengers rises, more aggressive encounters likely",
    "danger_level": "Very High (extreme cold, high winds, increased risk of frostbite, avalanches)"
  },
  "notes_for_next_state": {
    "wildlife_alert": "Scavengers are becoming increasingly aggressive due to prolonged lack of food. They are more likely to approach if they detect vulnerability.",
    "resource_change": "The difficulty of melting snow for water is increasing due to dropping temperatures, further complicating survival efforts.",
    "environmental_shift": "Severe blizzard conditions persist, with no immediate signs of weather improvement. The risk of avalanches remains high."
  }
}

