  "environment_status": {
    "terrain": "Rocky mountain terrain with sparse vegetation",
    "temperature": 2,
    "weather": "Overcast with strong winds and light snow",
    "food_availability": "Scarce - few edible roots and limited small game",
    "water_availability": "Stable - small trickling streams fed by melting snow",
    "shelter_options": "Few rocky overhangs and small caves, one occupied",
    "wildlife": "Scattered mountain goats, occasional birds, highly alert",
