  "environment_status": {
    "terrain": "Rocky mountain terrain with sparse vegetation",
    "temperature": 5,
    "weather": "Overcast with strong winds",
    "food_availability": "Very limited - some edible roots and sparse wild plants",
    "water_availability": "Small trickling streams fed by melting snow",
    "shelter_options": "Few rocky overhangs and small caves",
    "wildlife": "Scattered mountain goats, occasional birds",
